<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="bg-app text-white min-h-screen">
  <canvas id="bg-canvas" class="fixed inset-0 -z-10"></canvas>
  <%- include('../partials/admin-sidebar') %>

  <h1 class="text-2xl font-bold mb-6">Predictions</h1>

  <form method="GET" class="glass-card p-5 rounded-2xl mb-6 flex flex-wrap gap-3">
    <select name="outcome" class="input-field w-auto">
      <option value="all" <%= filters.outcome==='all'?'selected':'' %>>All Outcomes</option>
      <option value="Eligible" <%= filters.outcome==='Eligible'?'selected':'' %>>Eligible</option>
      <option value="Review" <%= filters.outcome==='Review'?'selected':'' %>>Review</option>
      <option value="Not Eligible" <%= filters.outcome==='Not Eligible'?'selected':'' %>>Not Eligible</option>
    </select>
    <select name="sort" class="input-field w-auto">
      <option value="newest" <%= filters.sort==='newest'?'selected':'' %>>Newest First</option>
      <option value="oldest" <%= filters.sort==='oldest'?'selected':'' %>>Oldest First</option>
    </select>
    <button type="submit" class="btn-gradient px-5 py-2 rounded-lg text-sm font-semibold">Filter</button>
  </form>

  <div class="glass-card rounded-2xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-white/5 text-slate-300">
        <tr>
          <th class="text-left px-6 py-3">Application</th>
          <th class="text-left px-6 py-3">Applicant</th>
          <th class="text-left px-6 py-3">Prediction</th>
          <th class="text-left px-6 py-3">Probability</th>
          <th class="text-left px-6 py-3">Model</th>
          <th class="text-left px-6 py-3">Feature Ver.</th>
          <th class="text-left px-6 py-3">Date</th>
          <th class="text-left px-6 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% if (predictions.length === 0) { %>
          <tr><td colspan="8" class="text-center py-10 text-slate-400">No predictions found.</td></tr>
        <% } %>
        <% predictions.forEach(p => { %>
          <tr class="border-t border-white/5 hover:bg-white/5 transition">
            <td class="px-6 py-3 font-medium"><%= p.application ? p.application.applicationId : 'N/A' %></td>
            <td class="px-6 py-3"><%= p.user ? p.user.fullName : 'N/A' %></td>
            <td class="px-6 py-3">
              <span class="status-pill <%= p.prediction==='Eligible'?'pill-green':p.prediction==='Review'?'pill-amber':'pill-red' %>">
                <%= p.prediction %>
              </span>
            </td>
            <td class="px-6 py-3"><%= Math.round(p.probability * 100) %>%</td>
            <td class="px-6 py-3"><%= p.modelName || p.model_name %> (<%= p.modelVersion || p.model_version %>)</td>
            <td class="px-6 py-3 text-slate-400"><%= p.featureVersion || p.feature_version || '—' %></td>
            <td class="px-6 py-3"><%= p.createdAt ? p.createdAt.toDateString() : 'N/A' %></td>
            <td class="px-6 py-3">
              <% if (p.application) { %>
                <a href="/admin/applications/<%= p.application._id %>" class="text-cyan-400 hover:underline">View →</a>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <%- include('../partials/admin-sidebar-end') %>
  <script src="/js/background.js"></script>
</body>
</html>