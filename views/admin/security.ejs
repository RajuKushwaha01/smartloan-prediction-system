<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="bg-app text-white min-h-screen">
  <canvas id="bg-canvas" class="fixed inset-0 -z-10"></canvas>
  <%- include('../partials/admin-sidebar') %>

  <h1 class="text-2xl font-bold mb-1">Security Monitoring</h1>
  <p class="text-slate-400 mb-8">Access-controlled view of authentication and account security events.</p>

  <% if (recentFailures.length > 0) { %>
    <div class="glass-card p-6 rounded-2xl mb-8 border border-red-500/30">
      <h3 class="font-bold text-red-400 text-sm mb-3">⚠ Suspicious Request Patterns</h3>
      <% recentFailures.forEach(f => { %>
        <p class="text-xs text-slate-300">5+ failed login attempts for <span class="font-semibold"><%= f._id %></span> in the last hour (<%= f.count %> attempts)</p>
      <% }) %>
    </div>
  <% } %>

  <div class="grid md:grid-cols-2 gap-6 mb-8">
    <div class="glass-card p-6 rounded-2xl">
      <h3 class="font-bold text-sm mb-4">🔒 Failed Login Attempts</h3>
      <div class="space-y-2 max-h-72 overflow-y-auto">
        <% if (failedLogins.length === 0) { %><p class="text-xs text-slate-500">None recorded.</p><% } %>
        <% failedLogins.forEach(f => { %>
          <div class="text-xs bg-white/5 rounded-lg p-3">
            <p class="text-slate-300"><%= f.email %> — <%= f.details %></p>
            <p class="text-slate-500 mt-1"><%= f.ip %> • <%= new Date(f.timestamp).toLocaleString('en-IN') %></p>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="glass-card p-6 rounded-2xl">
      <h3 class="font-bold text-sm mb-4">🔑 Password Changes</h3>
      <div class="space-y-2 max-h-72 overflow-y-auto">
        <% if (passwordChanges.length === 0) { %><p class="text-xs text-slate-500">None recorded.</p><% } %>
        <% passwordChanges.forEach(f => { %>
          <div class="text-xs bg-white/5 rounded-lg p-3">
            <p class="text-slate-300"><%= f.details %></p>
            <p class="text-slate-500 mt-1"><%= f.ip %> • <%= new Date(f.timestamp).toLocaleString('en-IN') %></p>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="glass-card p-6 rounded-2xl">
      <h3 class="font-bold text-sm mb-4">👤 Account Status Changes</h3>
      <div class="space-y-2 max-h-72 overflow-y-auto">
        <% if (accountStatusChanges.length === 0) { %><p class="text-xs text-slate-500">None recorded.</p><% } %>
        <% accountStatusChanges.forEach(f => { %>
          <div class="text-xs bg-white/5 rounded-lg p-3">
            <p class="text-slate-300"><%= f.details %></p>
            <p class="text-slate-500 mt-1"><%= new Date(f.timestamp).toLocaleString('en-IN') %></p>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="glass-card p-6 rounded-2xl">
      <h3 class="font-bold text-sm mb-4">🛡 Role Changes</h3>
      <div class="space-y-2 max-h-72 overflow-y-auto">
        <% if (roleChanges.length === 0) { %><p class="text-xs text-slate-500">None recorded.</p><% } %>
        <% roleChanges.forEach(f => { %>
          <div class="text-xs bg-white/5 rounded-lg p-3">
            <p class="text-slate-300"><%= f.details %></p>
            <p class="text-slate-500 mt-1"><%= new Date(f.timestamp).toLocaleString('en-IN') %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <%- include('../partials/admin-sidebar-end') %>
  <script src="/js/background.js"></script>
</body>
</html>