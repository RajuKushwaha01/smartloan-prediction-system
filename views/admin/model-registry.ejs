<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="bg-app text-white min-h-screen">
  <canvas id="bg-canvas" class="fixed inset-0 -z-10"></canvas>
  <%- include('../partials/admin-sidebar') %>

  <h1 class="text-2xl font-bold mb-1">Model Registry</h1>
  <p class="text-slate-400 mb-8">Every model version approved and registered by an administrator.</p>

  <% if (models.length === 0) { %>
    <div class="glass-card p-10 rounded-2xl text-center"><p class="text-slate-400">No models registered yet. Approve one from the <a href="/admin/retraining" class="text-cyan-400 hover:underline">Retraining</a> page.</p></div>
  <% } %>

  <div class="space-y-4">
    <% models.forEach(model => { %>
      <div class="glass-card p-6 rounded-2xl <%= model.status === 'Current' ? 'glow-border border border-cyan-500/30' : '' %>">
        <div class="flex flex-wrap justify-between items-start gap-4 mb-4">
          <div>
            <p class="font-bold text-lg"><%= model.version %> <span class="text-slate-400 font-normal text-sm">— <%= model.algorithm %></span></p>
            <p class="text-xs text-slate-500 mt-1">Trained <%= model.trainingDate ? new Date(model.trainingDate).toDateString() : 'Unknown' %> • Dataset <%= model.datasetVersion %> • Features <%= model.featureVersion %></p>
          </div>
          <span class="status-pill <%= model.status === 'Current' ? 'pill-green' : 'pill-amber' %>"><%= model.status === 'Current' ? 'CURRENT' : 'Archived' %></span>
        </div>
        <% if (model.metrics) { %>
          <div class="grid grid-cols-5 gap-3 text-center text-xs">
            <div class="bg-white/5 rounded-lg p-2"><p class="font-bold text-emerald-400"><%= (model.metrics.accuracy*100).toFixed(1) %>%</p><p class="text-slate-500">Accuracy</p></div>
            <div class="bg-white/5 rounded-lg p-2"><p class="font-bold text-cyan-400"><%= (model.metrics.precision*100).toFixed(1) %>%</p><p class="text-slate-500">Precision</p></div>
            <div class="bg-white/5 rounded-lg p-2"><p class="font-bold text-violet-400"><%= (model.metrics.recall*100).toFixed(1) %>%</p><p class="text-slate-500">Recall</p></div>
            <div class="bg-white/5 rounded-lg p-2"><p class="font-bold text-blue-400"><%= (model.metrics.f1_score*100).toFixed(1) %>%</p><p class="text-slate-500">F1</p></div>
            <div class="bg-white/5 rounded-lg p-2"><p class="font-bold text-amber-400"><%= (model.metrics.roc_auc*100).toFixed(1) %>%</p><p class="text-slate-500">ROC-AUC</p></div>
          </div>
        <% } %>
        <p class="text-xs text-slate-500 mt-3">Registered by <%= model.registeredBy %> on <%= model.registeredAt.toLocaleString('en-IN') %></p>
      </div>
    <% }) %>
  </div>

  <%- include('../partials/admin-sidebar-end') %>
  <script src="/js/background.js"></script>
</body>
</html>