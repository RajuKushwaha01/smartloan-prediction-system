<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-app text-white min-h-screen">
  <canvas id="bg-canvas" class="fixed inset-0 -z-10"></canvas>
  <%- include('../partials/admin-sidebar') %>

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-extrabold tracking-tight mb-1">User Management</h1>
    <p class="text-slate-400 text-sm">Manage user roles, monitor application counts, and control account activation status.</p>
  </div>

  <!-- Search & Filter Form -->
  <form method="GET" action="/admin/users" class="glass-card p-5 rounded-2xl mb-6 flex flex-wrap gap-3 border border-white/10">
    <input 
      type="text" 
      name="search" 
      value="<%= filters.search %>" 
      placeholder="Search name or email..." 
      class="input-field flex-1 min-w-[220px] text-sm" 
    />
    <select name="status" class="input-field w-auto text-sm">
      <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Status</option>
      <option value="Active" <%= filters.status === 'Active' ? 'selected' : '' %>>Active</option>
      <option value="Suspended" <%= filters.status === 'Suspended' ? 'selected' : '' %>>Suspended</option>
    </select>
    <button type="submit" class="btn-gradient px-5 py-2 rounded-xl text-sm font-semibold flex items-center gap-2">
      <span>🔍</span> Search
    </button>
  </form>

  <!-- Users Data Table -->
  <div class="glass-card rounded-2xl overflow-hidden border border-white/10">
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left">
        <thead class="bg-white/5 text-slate-300 font-semibold border-b border-white/10">
          <tr>
            <th class="px-6 py-3.5">Name</th>
            <th class="px-6 py-3.5">Email</th>
            <th class="px-6 py-3.5 text-center">Applications</th>
            <th class="px-6 py-3.5">Status</th>
            <th class="px-6 py-3.5">Role</th>
            <th class="px-6 py-3.5">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5 text-slate-200">
          <% if (users && users.length > 0) { %>
            <% users.forEach(u => { %>
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="px-6 py-4 font-medium text-white"><%= u.fullName %></td>
                <td class="px-6 py-4 text-slate-300"><%= u.email %></td>
                <td class="px-6 py-4 text-center font-semibold text-cyan-400">
                  <%= countMap[String(u._id)] || 0 %>
                </td>
                <td class="px-6 py-4">
                  <span class="status-pill <%= u.accountStatus === 'Active' ? 'pill-green' : 'pill-red' %>">
                    <%= u.accountStatus || 'Active' %>
                  </span>
                </td>
                <td class="px-6 py-4">
                  <form method="POST" action="/admin/users/<%= u._id %>/role" class="inline-flex items-center gap-2">
                    <%- include('../partials/csrf-field') %>
                    <select name="role" class="input-field text-xs py-1 px-2.5">
                      <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>User</option>
                      <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                    </select>
                    <button type="submit" class="text-cyan-400 hover:text-cyan-300 hover:underline text-xs font-semibold">
                      Save
                    </button>
                  </form>
                </td>
                <td class="px-6 py-4">
                  <form method="POST" action="/admin/users/<%= u._id %>/toggle-status">
                    <%- include('../partials/csrf-field') %>
                    <button 
                      type="submit" 
                      class="text-xs font-semibold hover:underline <%= u.accountStatus === 'Active' ? 'text-red-400 hover:text-red-300' : 'text-emerald-400 hover:text-emerald-300' %>"
                    >
                      <%= u.accountStatus === 'Active' ? 'Suspend' : 'Activate' %>
                    </button>
                  </form>
                  <a href="/admin/applications?userId=<%= u._id %>" class="text-cyan-400 hover:underline text-xs block mt-1">View Activity →</a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-slate-400">No users found matching the search criteria.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('../partials/admin-sidebar-end') %>

  <!-- External Scripts -->
  <script src="/js/background.js"></script>
  <script src="/js/interactions.js"></script>
</body>
</html>