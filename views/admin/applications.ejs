<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-app text-white min-h-screen">
  <canvas id="bg-canvas" class="fixed inset-0 -z-10"></canvas>
  <%- include('../partials/admin-sidebar') %>

  <!-- Page Header -->
  <div class="flex flex-wrap justify-between items-center mb-6 gap-4">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight">Applications</h1>
      <p class="text-slate-400 text-sm mt-1">Review, manage workflow states, and inspect notes for all loan applications.</p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/admin/export/csv" class="px-4 py-2 rounded-xl text-sm font-semibold border border-white/20 hover:bg-white/5 transition flex items-center gap-2">
        <span>⬇</span> Export CSV
      </a>
      <a href="/admin/export/excel" class="btn-gradient px-4 py-2 rounded-xl font-semibold text-sm flex items-center gap-2">
        <span>⬇</span> Export Excel
      </a>
    </div>
  </div>

  <!-- Filter & Search Bar -->
  <form method="GET" action="/admin/applications" class="glass-card p-5 rounded-2xl mb-6 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3 border border-white/10">
    <input type="text" name="search" value="<%= filters.search %>" placeholder="Search ID..." class="input-field text-sm" />

    <select name="status" class="input-field text-sm">
      <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Status</option>
      <option value="Pending" <%= filters.status === 'Pending' ? 'selected' : '' %>>Pending</option>
      <option value="Analyzed" <%= filters.status === 'Analyzed' ? 'selected' : '' %>>Analyzed</option>
    </select>

    <select name="workflowStatus" class="input-field text-sm">
      <option value="all" <%= filters.workflowStatus === 'all' ? 'selected' : '' %>>All Workflow</option>
      <option value="Submitted" <%= filters.workflowStatus === 'Submitted' ? 'selected' : '' %>>Submitted</option>
      <option value="Under Review" <%= filters.workflowStatus === 'Under Review' ? 'selected' : '' %>>Under Review</option>
      <option value="Approved" <%= filters.workflowStatus === 'Approved' ? 'selected' : '' %>>Approved</option>
      <option value="Rejected" <%= filters.workflowStatus === 'Rejected' ? 'selected' : '' %>>Rejected</option>
    </select>

    <input type="number" name="minAmount" value="<%= filters.minAmount || '' %>" placeholder="Min Amt (₹)" class="input-field text-sm" />
    <input type="number" name="maxAmount" value="<%= filters.maxAmount || '' %>" placeholder="Max Amt (₹)" class="input-field text-sm" />

    <select name="sort" class="input-field text-sm">
      <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
      <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
      <option value="amount" <%= filters.sort === 'amount' ? 'selected' : '' %>>Amount: High to Low</option>
    </select>

    <button type="submit" class="btn-gradient px-4 py-2 rounded-xl text-sm font-semibold flex items-center justify-center gap-2">
      <span>🔍</span> Filter
    </button>
  </form>

  <!-- Applications Data Table -->
  <div class="glass-card rounded-2xl overflow-hidden border border-white/10 p-6">
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left">
        <thead class="bg-white/5 text-slate-300 font-semibold border-b border-white/10">
          <tr>
            <th class="px-6 py-3.5">ID</th>
            <th class="px-6 py-3.5">Applicant</th>
            <th class="px-6 py-3.5">Amount</th>
            <th class="px-6 py-3.5">Prediction</th>
            <th class="px-6 py-3.5">Workflow</th>
            <th class="px-6 py-3.5">Notes</th>
            <th class="px-6 py-3.5">Update Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5 text-slate-200">
          <% if (applications && applications.length > 0) { %>
            <% applications.forEach(app => { 
                const pred = predictionMap[String(app._id)];
                const noteCount = (app.internalNotes && app.internalNotes.length) || 0;
            %>
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="px-6 py-4 font-mono text-cyan-400 font-medium">
                  <a href="/admin/applications/<%= app._id %>" class="hover:text-cyan-300 hover:underline"><%= app.applicationId %></a>
                </td>
                <td class="px-6 py-4">
                  <p class="font-medium text-white"><%= app.user ? app.user.fullName : 'N/A' %></p>
                  <p class="text-xs text-slate-400"><%= app.user ? app.user.email : '' %></p>
                </td>
                <td class="px-6 py-4 font-semibold">₹<%= app.loanAmount ? app.loanAmount.toLocaleString('en-IN') : 0 %></td>
                <td class="px-6 py-4">
                  <% if (pred) { %>
                    <span class="status-pill <%= pred.prediction === 'Eligible' ? 'pill-green' : pred.prediction === 'Review' ? 'pill-amber' : 'pill-red' %>">
                      <%= pred.prediction %>
                    </span>
                  <% } else { %>
                    <span class="text-slate-500 text-xs italic">Pending Analysis</span>
                  <% } %>
                </td>
                <td class="px-6 py-4">
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-slate-300">
                    <%= app.workflowStatus %>
                  </span>
                </td>
                <td class="px-6 py-4">
                  <span class="text-xs text-slate-400"><%= noteCount %> note(s)</span>
                  <button type="button" class="text-cyan-400 hover:text-cyan-300 hover:underline text-xs font-semibold ml-2 note-toggle focus:outline-none" data-id="<%= app._id %>">
                    <%= noteCount > 0 ? 'View / + Add' : '+ Add' %>
                  </button>
                </td>
                <td class="px-6 py-4">
                  <form method="POST" action="/admin/applications/<%= app._id %>/status" class="flex items-center gap-2">
                    <%- include('../partials/csrf-field') %>
                    <select name="workflowStatus" class="input-field text-xs py-1 px-2">
                      <option value="Submitted" <%= app.workflowStatus === 'Submitted' ? 'selected' : '' %>>Submitted</option>
                      <option value="Under Review" <%= app.workflowStatus === 'Under Review' ? 'selected' : '' %>>Under Review</option>
                      <option value="Approved" <%= app.workflowStatus === 'Approved' ? 'selected' : '' %>>Approved</option>
                      <option value="Rejected" <%= app.workflowStatus === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                    </select>
                    <button type="submit" class="text-cyan-400 hover:text-cyan-300 hover:underline text-xs font-semibold">Save</button>
                  </form>
                </td>
              </tr>

              <!-- Collapsible Notes Sub-Row -->
              <tr id="note-row-<%= app._id %>" class="hidden border-t border-white/5 bg-white/[0.02]">
                <td colspan="7" class="px-6 py-4">
                  <div class="max-w-3xl">
                    <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Internal Notes & History</h4>
                    <% if (noteCount > 0) { %>
                      <div class="space-y-2 mb-4">
                        <% app.internalNotes.forEach(n => { %>
                          <div class="text-xs text-slate-300 bg-white/5 border border-white/5 rounded-xl p-3 flex justify-between items-start">
                            <div>
                              <span class="text-cyan-400 font-semibold"><%= n.addedBy %>:</span>
                              <span class="ml-1"><%= n.note %></span>
                            </div>
                            <span class="text-slate-500 text-[11px] ml-4 whitespace-nowrap"><%= new Date(n.addedAt).toLocaleString('en-IN') %></span>
                          </div>
                        <% }) %>
                      </div>
                    <% } else { %>
                      <p class="text-xs text-slate-500 italic mb-3">No notes added yet for this application.</p>
                    <% } %>

                    <!-- Add Note Form -->
                    <form method="POST" action="/admin/applications/<%= app._id %>/note" class="flex gap-2">
                      <%- include('../partials/csrf-field') %>
                      <input type="text" name="note" placeholder="Type internal note here..." class="input-field text-xs flex-1" required />
                      <button type="submit" class="btn-gradient px-4 py-2 rounded-xl text-xs font-semibold">Add Note</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="px-6 py-8 text-center text-slate-400">No applications match the selected criteria.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- ============ PAGINATION CONTROLS ============ -->
    <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
      <div class="flex justify-between items-center mt-6 text-sm text-slate-400">
        <p>Showing page <%= pagination.currentPage %> of <%= pagination.totalPages %> (<%= pagination.totalCount %> total)</p>
        <div class="flex gap-2">
          <% if (pagination.currentPage > 1) { %>
            <a href="?page=<%= pagination.currentPage - 1 %>" class="px-3 py-1.5 rounded-lg border border-white/20 hover:bg-white/5 transition">← Prev</a>
          <% } %>
          <% if (pagination.currentPage < pagination.totalPages) { %>
            <a href="?page=<%= pagination.currentPage + 1 %>" class="px-3 py-1.5 rounded-lg border border-white/20 hover:bg-white/5 transition">Next →</a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

  <%- include('../partials/admin-sidebar-end') %>

  <!-- External Scripts -->
  <script src="/js/background.js"></script>
  <script src="/js/interactions.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.note-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const targetRow = document.getElementById('note-row-' + btn.dataset.id);
          if (targetRow) {
            targetRow.classList.toggle('hidden');
          }
        });
      });
    });
  </script>
  <script src="/js/debounced-search.js"></script>
</body>
</html>