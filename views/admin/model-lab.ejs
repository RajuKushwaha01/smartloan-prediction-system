<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="bg-app text-white min-h-screen">
  <canvas id="bg-canvas" class="fixed inset-0 -z-10"></canvas>
  <%- include('../partials/admin-sidebar') %>

  <h1 class="text-2xl font-bold mb-1">Model Comparison Laboratory</h1>
  <p class="text-slate-400 mb-8">Head-to-head comparison of every trained candidate — admin only.</p>

  <% if (error) { %>
    <div class="glass-card p-8 rounded-2xl text-center"><p class="text-amber-400">⚠ <%= error %></p></div>
  <% } else { %>
    <div class="glass-card rounded-2xl overflow-hidden mb-8">
      <table class="w-full text-sm">
        <thead class="bg-white/5 text-slate-300">
          <tr><th class="text-left px-6 py-3">Model</th><th class="text-left px-6 py-3">Accuracy</th><th class="text-left px-6 py-3">Precision</th><th class="text-left px-6 py-3">Recall</th><th class="text-left px-6 py-3">F1</th><th class="text-left px-6 py-3">ROC-AUC</th><th class="text-left px-6 py-3">Training Time</th></tr>
        </thead>
        <tbody>
          <% Object.entries(metrics.all_models).forEach(([name, stats]) => { %>
            <tr class="border-t border-white/5 <%= name === metrics.selected_model ? 'bg-cyan-400/5' : '' %>">
              <td class="px-6 py-3 font-medium"><%= name %> <% if (name === metrics.selected_model) { %><span class="text-cyan-400 text-xs">★ selected</span><% } %></td>
              <td class="px-6 py-3"><%= (stats.accuracy*100).toFixed(2) %>%</td>
              <td class="px-6 py-3"><%= (stats.precision*100).toFixed(2) %>%</td>
              <td class="px-6 py-3"><%= (stats.recall*100).toFixed(2) %>%</td>
              <td class="px-6 py-3"><%= (stats.f1_score*100).toFixed(2) %>%</td>
              <td class="px-6 py-3"><%= (stats.roc_auc*100).toFixed(2) %>%</td>
              <td class="px-6 py-3"><%= stats.training_time_seconds || '—' %>s</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="glass-card p-8 rounded-2xl mb-8">
      <h2 class="font-bold text-lg mb-4">Confusion Matrix — <%= metrics.selected_model %></h2>
      <% const m = metrics.selected_model_metrics; %>
      <div class="grid grid-cols-2 gap-2 max-w-sm mx-auto text-center text-sm">
        <div class="bg-emerald-500/15 border border-emerald-500/30 rounded-lg p-4"><p class="text-2xl font-bold"><%= m.confusion_matrix[0][0] %></p><p class="text-xs text-slate-400 mt-1">True Negative</p></div>
        <div class="bg-red-500/15 border border-red-500/30 rounded-lg p-4"><p class="text-2xl font-bold"><%= m.confusion_matrix[0][1] %></p><p class="text-xs text-slate-400 mt-1">False Positive</p></div>
        <div class="bg-red-500/15 border border-red-500/30 rounded-lg p-4"><p class="text-2xl font-bold"><%= m.confusion_matrix[1][0] %></p><p class="text-xs text-slate-400 mt-1">False Negative</p></div>
        <div class="bg-emerald-500/15 border border-emerald-500/30 rounded-lg p-4"><p class="text-2xl font-bold"><%= m.confusion_matrix[1][1] %></p><p class="text-xs text-slate-400 mt-1">True Positive</p></div>
      </div>
    </div>

    <% if (metrics.feature_importance_global) { %>
      <div class="glass-card p-8 rounded-2xl mb-8">
        <h2 class="font-bold text-lg mb-6">Feature Importance</h2>
        <div class="space-y-4">
          <% metrics.feature_importance_global.forEach(f => { %>
            <div><div class="flex justify-between text-sm mb-1"><span><%= f.feature.replace(/_/g,' ') %></span><span class="text-slate-400"><%= (f.importance*100).toFixed(1) %>%</span></div><div class="w-full bg-white/10 rounded-full h-2 overflow-hidden"><div class="h-2 btn-gradient rounded-full" style="width:<%= Math.min(100,f.importance*100*4) %>%"></div></div></div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <div class="grid md:grid-cols-2 gap-6">
      <div class="glass-card p-6 rounded-2xl"><p class="text-xs text-slate-400">Dataset Version</p><p class="text-xl font-bold"><%= metrics.dataset_version %></p></div>
      <div class="glass-card p-6 rounded-2xl"><p class="text-xs text-slate-400">Feature Version</p><p class="text-xl font-bold"><%= metrics.feature_version %></p></div>
    </div>
  <% } %>

  <%- include('../partials/admin-sidebar-end') %>
  <script src="/js/background.js"></script>
</body>
</html>