<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-app text-white min-h-screen">
  <canvas id="bg-canvas" class="fixed inset-0 -z-10"></canvas>
  <%- include('../partials/admin-sidebar') %>

  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-extrabold mb-1 tracking-tight">Admin Dashboard</h1>
    <p class="text-slate-400 text-sm">Monitor applications, predictions, and overall system metrics in real time.</p>
  </div>

  <!-- Real-time Badge & Live Activity Feed -->
  <div id="realtime-badge" class="hidden inline-flex items-center gap-2 bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-sm px-4 py-2 rounded-full mb-6">🔔 0 New Applications</div>

  <div class="glass-card p-6 rounded-2xl mb-8">
    <h3 class="font-bold text-sm mb-3">🔴 Live Activity Feed</h3>
    <div id="realtime-list" class="max-h-48 overflow-y-auto">
      <p class="text-xs text-slate-500">Waiting for new activity...</p>
    </div>
  </div>

  <!-- Stat Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5 mb-10">
    <div class="glass-card p-6 rounded-2xl hover-lift border border-white/10">
      <p class="text-slate-400 text-xs font-semibold uppercase tracking-wider mb-2">Total Users</p>
      <p class="text-3xl font-extrabold text-white"><span data-counter="<%= totalUsers %>">0</span></p>
    </div>

    <div class="glass-card p-6 rounded-2xl hover-lift border border-white/10">
      <p class="text-slate-400 text-xs font-semibold uppercase tracking-wider mb-2">Applications</p>
      <p class="text-3xl font-extrabold text-white"><span data-counter="<%= totalApplications %>">0</span></p>
    </div>

    <div class="glass-card p-6 rounded-2xl hover-lift border border-emerald-500/20">
      <p class="text-slate-400 text-xs font-semibold uppercase tracking-wider mb-2">Eligible</p>
      <p class="text-3xl font-extrabold text-emerald-400"><span data-counter="<%= eligible %>">0</span></p>
    </div>

    <div class="glass-card p-6 rounded-2xl hover-lift border border-amber-500/20">
      <p class="text-slate-400 text-xs font-semibold uppercase tracking-wider mb-2">In Review</p>
      <p class="text-3xl font-extrabold text-amber-400"><span data-counter="<%= review %>">0</span></p>
    </div>

    <div class="glass-card p-6 rounded-2xl hover-lift border border-red-500/20">
      <p class="text-slate-400 text-xs font-semibold uppercase tracking-wider mb-2">Not Eligible</p>
      <p class="text-3xl font-extrabold text-red-400"><span data-counter="<%= notEligible %>">0</span></p>
    </div>
  </div>

  <!-- Chart Section -->
  <div class="glass-card p-6 rounded-2xl mb-10 border border-white/10">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold text-white">Prediction Distribution</h2>
      <span class="text-xs text-slate-400">Total Analyzed: <%= totalPredictions %></span>
    </div>
    <div class="relative max-w-xs mx-auto h-64">
      <canvas id="distChart"></canvas>
    </div>
  </div>

  <!-- Table Section Header -->
  <div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-bold text-white">Recent Applications</h2>
    <a href="/admin/applications" class="text-cyan-400 hover:text-cyan-300 transition-colors text-sm font-semibold flex items-center gap-1">
      View All <span>→</span>
    </a>
  </div>

  <!-- Applications Table -->
  <div class="glass-card rounded-2xl overflow-hidden border border-white/10">
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left">
        <thead class="bg-white/5 text-slate-300 font-semibold border-b border-white/10">
          <tr>
            <th class="px-6 py-3.5">ID</th>
            <th class="px-6 py-3.5">Applicant</th>
            <th class="px-6 py-3.5">Amount</th>
            <th class="px-6 py-3.5">Status</th>
            <th class="px-6 py-3.5">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5 text-slate-200">
          <% if (recentApplications && recentApplications.length > 0) { %>
            <% recentApplications.forEach(app => { %>
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="px-6 py-4 font-mono text-cyan-400"><%= app.applicationId %></td>
                <td class="px-6 py-4 font-medium"><%= app.user ? app.user.fullName : 'N/A' %></td>
                <td class="px-6 py-4">₹<%= app.loanAmount ? app.loanAmount.toLocaleString('en-IN') : 0 %></td>
                <td class="px-6 py-4">
                  <span class="status-pill <%= app.status === 'Analyzed' ? 'pill-green' : 'pill-amber' %>">
                    <%= app.status %>
                  </span>
                </td>
                <td class="px-6 py-4 text-slate-400"><%= new Date(app.createdAt).toDateString() %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="px-6 py-8 text-center text-slate-400">No recent applications found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('../partials/admin-sidebar-end') %>

  <!-- External Scripts -->
  <script src="/js/background.js"></script>
  <script src="/js/interactions.js"></script>
  <script src="/js/admin-realtime.js"></script>
  
  <!-- Chart Initialization -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const ctx = document.getElementById('distChart').getContext('2d');
      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['Eligible', 'Review', 'Not Eligible'],
          datasets: [{
            data: [<%= eligible %>, <%= review %>, <%= notEligible %>],
            backgroundColor: ['#10B981', '#F59E0B', '#EF4444'],
            borderWidth: 0,
            hoverOffset: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                color: '#F8FAFC',
                padding: 16,
                font: {
                  family: 'Inter',
                  size: 12
                }
              }
            }
          },
          cutout: '70%'
        }
      });
    });
  </script>
</body>
</html>s