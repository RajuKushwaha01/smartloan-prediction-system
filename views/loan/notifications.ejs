<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="bg-app text-white min-h-screen">
  <canvas id="bg-canvas" class="fixed inset-0 -z-10"></canvas>
  <%- include('../partials/navbar') %>

  <div class="max-w-3xl mx-auto px-6 pt-28 pb-16">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold">Notification Center</h1>
      <button id="mark-all-read-btn" class="text-cyan-400 hover:underline text-sm">Mark All as Read</button>
    </div>

    <div class="flex gap-2 mb-6">
      <a href="/loan/notifications/history" class="px-4 py-1.5 rounded-lg text-xs font-semibold <%= filterStatus==='all' ? 'btn-gradient' : 'border border-white/20 hover:bg-white/5' %> transition">All</a>
      <a href="/loan/notifications/history?status=unread" class="px-4 py-1.5 rounded-lg text-xs font-semibold <%= filterStatus==='unread' ? 'btn-gradient' : 'border border-white/20 hover:bg-white/5' %> transition">Unread</a>
      <a href="/loan/notifications/history?status=read" class="px-4 py-1.5 rounded-lg text-xs font-semibold <%= filterStatus==='read' ? 'btn-gradient' : 'border border-white/20 hover:bg-white/5' %> transition">Read</a>
    </div>

    <div class="space-y-2">
      <% if (notifications.length === 0) { %>
        <div class="glass-card p-10 rounded-2xl text-center"><p class="text-slate-400">No notifications here.</p></div>
      <% } %>
      <% notifications.forEach(n => { %>
        <div class="glass-card p-4 rounded-xl flex items-start gap-3 <%= n.read ? 'opacity-60' : '' %>" id="notif-item-<%= n._id %>">
          <span class="text-lg mt-0.5">
            <% if (n.type === 'success') { %><span class="text-emerald-400">✓</span>
            <% } else if (n.type === 'warning') { %><span class="text-amber-400">⚠</span>
            <% } else { %><span class="text-cyan-400">ℹ</span><% } %>
          </span>
          <div class="flex-1">
            <a href="<%= n.link || '#' %>" class="text-sm text-slate-200 hover:text-cyan-400 transition"><%= n.message %></a>
            <p class="text-xs text-slate-500 mt-1"><%= new Date(n.createdAt).toLocaleString('en-IN') %></p>
          </div>
          <% if (!n.read) { %>
            <button class="mark-read-btn text-xs text-cyan-400 hover:underline" data-id="<%= n._id %>">Mark Read</button>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>

  <script src="/js/background.js"></script>
  <script>
    document.querySelectorAll('.mark-read-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        await fetch(`/loan/notifications/${id}/read`, { method: 'POST' });
        document.getElementById(`notif-item-${id}`).classList.add('opacity-60');
        btn.remove();
      });
    });

    document.getElementById('mark-all-read-btn').addEventListener('click', async () => {
      await fetch('/loan/notifications/read', { method: 'POST' });
      location.reload();
    });
  </script>
</body>
</html>