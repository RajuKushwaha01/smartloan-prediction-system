<div class="glass-card p-8 rounded-2xl mb-6">
  <h3 class="font-bold text-lg mb-2">🎨 Appearance</h3>
  <p class="text-sm text-slate-400 mb-5">Choose your preferred theme for this device.</p>

  <div class="grid grid-cols-2 gap-4">
    <button type="button" data-theme-btn="light" class="theme-option-card">
      <span class="text-3xl mb-2 block">☀️</span>
      <span class="font-semibold text-sm">Light</span>
      <span class="theme-option-check">✓</span>
    </button>
    <button type="button" data-theme-btn="dark" class="theme-option-card">
      <span class="text-3xl mb-2 block">🌙</span>
      <span class="font-semibold text-sm">Dark</span>
      <span class="theme-option-check">✓</span>
    </button>
  </div>
</div>