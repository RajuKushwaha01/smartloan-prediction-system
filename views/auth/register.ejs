<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="bg-app text-white min-h-screen flex items-center justify-center px-6 py-20">
  <canvas id="bg-canvas" class="fixed inset-0 -z-10"></canvas>

  <div class="glass-card w-full max-w-md p-8 rounded-2xl glow-border">
    <h1 class="text-2xl font-bold mb-1">Create Your Account</h1>
    <p class="text-slate-400 mb-6 text-sm">Join SmartLoan AI</p>

    <% if (error) { %>
      <div class="bg-red-500/10 border border-red-500/40 text-red-300 text-sm px-4 py-2 rounded-lg mb-4">⚠ <%= error %></div>
    <% } %>

    <form method="POST" action="/auth/register" class="space-y-4">
      <%- include('../partials/csrf-field') %>
      <div>
        <label class="text-sm text-slate-300">Full Name</label>
        <input type="text" name="fullName" value="<%= old.fullName || '' %>" required class="input-field" />
      </div>
      <div>
        <label class="text-sm text-slate-300">Email</label>
        <input type="email" name="email" value="<%= old.email || '' %>" required class="input-field" />
      </div>
      <div>
        <label class="text-sm text-slate-300">Phone <span class="text-slate-500">(optional)</span></label>
        <input type="text" name="phone" value="<%= old.phone || '' %>" class="input-field" />
      </div>
      <div>
        <label class="text-sm text-slate-300">Address <span class="text-slate-500">(optional)</span></label>
        <input type="text" name="address" value="<%= old.address || '' %>" class="input-field" />
      </div>

      <!-- City, State, Pincode Grid -->
      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="text-sm text-slate-300">City</label>
          <input type="text" name="city" value="<%= old.city || '' %>" class="input-field" />
        </div>
        <div>
          <label class="text-sm text-slate-300">State</label>
          <input type="text" name="state" value="<%= old.state || '' %>" class="input-field" />
        </div>
        <div>
          <label class="text-sm text-slate-300">Pincode</label>
          <input type="text" name="pincode" value="<%= old.pincode || '' %>" class="input-field" />
        </div>
      </div>

      <div>
        <label class="text-sm text-slate-300">Password</label>
        <input type="password" name="password" required class="input-field" />
        <p class="text-xs text-slate-500 mt-1">At least 6 characters</p>
      </div>
      <div>
        <label class="text-sm text-slate-300">Confirm Password</label>
        <input type="password" name="confirmPassword" required class="input-field" />
      </div>
      <button type="submit" class="btn-gradient w-full py-3 rounded-lg font-semibold mt-2">CREATE ACCOUNT</button>
    </form>

    <p class="text-center text-sm text-slate-400 mt-6">
      Already have an account? <a href="/auth/login" class="text-cyan-400 hover:underline">Sign in</a>
    </p>
  </div>
  <script src="/js/background.js"></script>
</body>
</html>