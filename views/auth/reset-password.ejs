<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="bg-app text-white min-h-screen flex items-center justify-center px-6">
  <canvas id="bg-canvas" class="fixed inset-0 -z-10"></canvas>

  <div class="glass-card w-full max-w-md p-8 rounded-2xl glow-border">
    <h1 class="text-2xl font-bold mb-1">Reset Password</h1>
    <p class="text-slate-400 mb-6 text-sm">Choose a new password for your account.</p>

    <% if (error) { %>
      <div class="bg-red-500/10 border border-red-500/40 text-red-300 text-sm px-4 py-2 rounded-lg mb-4">⚠ <%= error %></div>
    <% } %>

    <% if (token) { %>
      <form method="POST" action="/auth/reset-password/<%= token %>" class="space-y-4">
        <%- include('../partials/csrf-field') %>
        <div>
          <label class="text-sm text-slate-300">New Password</label>
          <input type="password" name="password" required class="input-field" />
          <p class="text-xs text-slate-500 mt-1">At least 6 characters</p>
        </div>
        <div>
          <label class="text-sm text-slate-300">Confirm New Password</label>
          <input type="password" name="confirmPassword" required class="input-field" />
        </div>
        <button type="submit" class="btn-gradient w-full py-3 rounded-lg font-semibold mt-2">RESET PASSWORD</button>
      </form>
    <% } else { %>
      <a href="/auth/forgot-password" class="btn-gradient block text-center w-full py-3 rounded-lg font-semibold">Request a New Link</a>
    <% } %>
  </div>
  <script src="/js/background.js"></script>
</body>
</html>