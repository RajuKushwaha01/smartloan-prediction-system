<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="bg-app text-white min-h-screen flex items-center justify-center px-6">
  <canvas id="bg-canvas" class="fixed inset-0 -z-10"></canvas>

  <div class="glass-card w-full max-w-md p-8 rounded-2xl glow-border">
    <h1 class="text-2xl font-bold mb-1">Forgot Password</h1>
    <p class="text-slate-400 mb-6 text-sm">Enter your email and we'll send you a reset link.</p>

    <% if (error) { %>
      <div class="bg-red-500/10 border border-red-500/40 text-red-300 text-sm px-4 py-2 rounded-lg mb-4">⚠ <%= error %></div>
    <% } %>
    <% if (message) { %>
      <div class="bg-emerald-500/10 border border-emerald-500/40 text-emerald-300 text-sm px-4 py-2 rounded-lg mb-4">✓ <%= message %></div>
    <% } %>
    <% if (devResetUrl) { %>
      <div class="bg-amber-500/10 border border-amber-500/40 text-amber-300 text-xs px-4 py-3 rounded-lg mb-4 break-all">
        <p class="font-semibold mb-1">⚠ Demo Mode (no SMTP configured)</p>
        <a href="<%= devResetUrl %>" class="underline"><%= devResetUrl %></a>
      </div>
    <% } %>

    <form method="POST" action="/auth/forgot-password" class="space-y-4">
      <%- include('../partials/csrf-field') %>
      <div>
        <label class="text-sm text-slate-300">Email</label>
        <input type="email" name="email" required class="input-field" placeholder="Enter your registered email" />
      </div>
      <button type="submit" class="btn-gradient w-full py-3 rounded-lg font-semibold mt-2">SEND RESET LINK</button>
    </form>

    <p class="text-center text-sm text-slate-400 mt-6">
      <a href="/auth/login" class="text-cyan-400 hover:underline">← Back to Login</a>
    </p>
  </div>
  <script src="/js/background.js"></script>
</body>
</html>