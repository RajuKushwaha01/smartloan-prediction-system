NODE_ENV=production
PORT=3000

# Set after creating a MongoDB Atlas cluster
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartloan_ai

SESSION_SECRET=replace_with_a_long_random_string

# Set this AFTER deploying the Python ML service on Render (its URL)
ML_API_URL=https://smartloan-ai-ml.onrender.com

# Set this AFTER deploying this Node service on Render (its own URL)
APP_BASE_URL=https://smartloan-ai-node.onrender.com

FORCE_HTTPS_COOKIES=true

# Optional — leave blank, app works fully without these
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GEMINI_API_KEY=